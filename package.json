{
  "name": "smart-bhumi-seba",
  "version": "1.0.0",
  "description": "Smart Bhumi Seba - Citizen Pre-Purchase Land Verification Backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "node scripts/build-client.js",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node --check scripts/*.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
