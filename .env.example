# Template only. Copy to .env for local development. Never commit secrets.
# Server runtime only:
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_SERVER_RUNTIME_ONLY
ALLOWED_ORIGINS=http://localhost:8888,http://localhost:3000
DATA_MODE=synthetic
ACTIVE_RULES_VERSION=v1
ACTIVE_DATASET_VERSION=synthetic-v2

# Deliberately public browser configuration:
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_KEY
